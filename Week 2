import torch
import cv2
from matplotlib import pyplot as plt

# Load YOLOv5 model from PyTorch Hub
model = torch.hub.load('ultralytics/yolov5', 'yolov5s', pretrained=True)

# Classes YOLOv5 can detect
animal_classes = ['cat', 'dog', 'bird', 'cow', 'horse', 'sheep']

# Load an image (you can change this to a path to your image)
img_path = 'sample.jpg'  # Replace with your image file
img = cv2.imread(img_path)
img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

# Inference
results = model(img_rgb)

# Convert results to pandas DataFrame
df = results.pandas().xyxy[0]

# Filter only animals
df_animals = df[df['name'].isin(animal_classes)]

# Draw boxes around detected animals
for index, row in df_animals.iterrows():
    xmin, ymin, xmax, ymax = int(row['xmin']), int(row['ymin']), int(row['xmax']), int(row['ymax'])
    label = row['name']
    confidence = row['confidence']
    cv2.rectangle(img, (xmin, ymin), (xmax, ymax), (0, 255, 0), 2)
    cv2.putText(img, f"{label} {confidence:.2f}", (xmin, ymin - 10),
                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

# Show image
plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
plt.title('Detected Animals')
plt.axis('off')
plt.show()
